# Copiez ce fichier en .env et renseignez votre valeur.
# Le .env reste sur votre machine : ni dans git, ni dans l'image.
OPENAI_API_KEY=<votre clé OpenAI>
ANTHROPIC_API_KEY=<votre clé Anthropic>
app_pass=<votre mot de passe pour l'interface web>
ANTHROPIC_MODEL=claude-haiku-4-5
RANDONEO_MAX_ITERATIONS=8  

